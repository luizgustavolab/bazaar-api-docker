{
  "name": "bazaar-api-monorepo",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "generate": "npx prisma generate",
    "db:push": "npx prisma db push --schema=./prisma/schema.prisma",
    "clean": "rimraf dist apps/api/dist apps/crawler/dist apps/worker/dist",
    "prebuild": "npm run clean",
    "build": "npx prisma generate && tsc -p apps/api/tsconfig.json --skipLibCheck && tsc -p apps/worker/tsconfig.json --skipLibCheck && tsc -p apps/crawler/tsconfig.json --skipLibCheck",
    "start": "node apps/api/dist/server.js",
    "start:api": "node apps/api/dist/server.js",
    "start:worker": "node apps/worker/dist/worker/src/index.js",
    "start:crawler": "node apps/crawler/dist/crawler/src/index.js",
    "seed": "tsx prisma/seed.ts",
    "dev": "npm run generate && concurrently -p \"name\" -n \"API,WORKER,CRAWLER\" -c \"cyan,green,magenta\" \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:crawler\"",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:worker": "tsx watch apps/worker/src/index.ts",
    "dev:crawler": "tsx watch apps/crawler/src/index.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\""
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.13.6",
    "bullmq": "^5.70.1",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^4.28.0",
    "ioredis": "^5.10.1",
    "node-cron": "^3.0.3",
    "playwright": "^1.62.1",
    "prisma": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/node-cron": "3.0.11",
    "@types/sqlite3": "^3.1.11",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "concurrently": "^8.2.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
