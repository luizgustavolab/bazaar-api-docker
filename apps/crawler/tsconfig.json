{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "rootDir": "../",
    "outDir": "dist",
    "baseUrl": ".",
    "lib": ["ES2022", "DOM"],
    "strict": false,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "allowJs": true
  },
  "include": [
    "src/**/*",
    "../api/src/lib/**/*",
    "../api/src/config/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}