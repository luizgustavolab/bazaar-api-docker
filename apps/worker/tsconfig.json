{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "strict": false,
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@api/*": ["../api/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}