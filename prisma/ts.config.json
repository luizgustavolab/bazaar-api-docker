{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS", 
    "moduleResolution": "node",
    "outDir": "../dist/prisma",
    "rootDir": ".",
    "types": ["node"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["seed.ts", "../apps/api/src/prismaApi.ts"]
}