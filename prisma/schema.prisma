// Configuração do gerador para aceitar o Driver Adapter (Turso/LibSQL)
generator client {
  provider        = "prisma-client-js"
  url      = env("TURSO_DATABASE_URL")
  previewFeatures = ["driverAdapters"]
}

// Mantemos sqlite como provider, o adapter do LibSQL fará a ponte em runtime
datasource db {
  provider = "sqlite"
  }

model Character {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  vocation  String
  level     Int
  world     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Armazenados como JSON String (JSON.stringify / JSON.parse)
  items     String?
  outfitUrl String?
  skills    String?
  
  // Relação 1:1 com Auction
  auction   Auction?
}

model Auction {
  id          Int       @id @default(autoincrement())
  characterId Int       @unique
  price       Int
  startedAt   DateTime  @default(now())
  endsAt      String    // Mantido como String conforme seu crawler/worker
  
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}